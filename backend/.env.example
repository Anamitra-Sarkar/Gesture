# Application Configuration
APP_NAME="Hand Gesture Recognition Platform"
APP_VERSION="1.0.0"
DEBUG_MODE=false

# CORS Settings (comma-separated list, no trailing slashes)
# Example: CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# For production: CORS_ORIGINS=https://your-frontend-domain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Camera Settings
CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30

# MediaPipe Settings
MP_MODEL_COMPLEXITY=1
MP_MIN_DETECTION_CONFIDENCE=0.7
MP_MIN_TRACKING_CONFIDENCE=0.5
MP_MAX_NUM_HANDS=2

# Processing Settings
FRAME_SKIP=1
LANDMARK_SMOOTHING_FACTOR=0.3

# Video Upload Settings
MAX_VIDEO_SIZE_MB=100
UPLOAD_DIR=uploads

# Gesture Recognition
GESTURE_CONFIDENCE_THRESHOLD=0.75
GESTURE_TEMPORAL_WINDOW=5
